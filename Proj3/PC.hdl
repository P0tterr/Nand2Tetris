// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    // 1. Incrementa o valor atual
    Inc16(in=feedback, out=incremented);

    // 2. Escolhe entre valor atual e incrementado
    Mux16(a=feedback, b=incremented, sel=inc, out=afterInc);

    // 3. Escolhe entre o resultado acima e 'in' (jump)
    Mux16(a=afterInc, b=in, sel=load, out=afterLoad);

    // 4. Escolhe entre o resultado acima e 0 (reset)
    Mux16(a=afterLoad, b=false, sel=reset, out=afterReset);

    // 5. Armazena e faz o feedback
    Register(in=afterReset, load=true, out=out, out=feedback);
}